<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ht_ros2_control</name>
  <version>0.1.0</version>
  <description>HighTorque ros2_control hardware package (Panthera HT via motor_cpp / hightorque_motor)</description>
  <maintainer email="fa@example.com">fa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <!-- Used by vendored motor_cpp (serial + YAML motor bus config). LCM is optional and OFF for this HI. -->
  <depend>libserialport</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/ht_ros2_control.xml"/>
  </export>
</package>
